<!-- Allowlist for system packages included in pixel_experience_2017_and_newer.mk -->
<config>
    <!--  Chrome (Chrome) -->
    <install-in-user-type package="com.android.chrome">
        <install-in user-type="FULL" />
        <install-in user-type="android.os.usertype.profile.MANAGED" />
        <install-in user-type="android.os.usertype.profile.PRIVATE" />
    </install-in-user-type>

    <!--  Camera (GoogleCamera) -->
    <install-in-user-type package="com.google.android.GoogleCamera">
        <install-in user-type="FULL" />
        <install-in user-type="android.os.usertype.profile.MANAGED" />
        <install-in user-type="android.os.usertype.profile.PRIVATE" />
    </install-in-user-type>

    <!--  Wellbeing App (WellbeingPrebuilt) -->
    <install-in-user-type package="com.google.android.apps.wellbeing">
        <install-in user-type="FULL" />
        <install-in user-type="android.os.usertype.profile.MANAGED" />
    </install-in-user-type>

    <!--  Developer Verifier App (VerifierPrebuiltClassic) -->
    <install-in-user-type package="com.google.android.verifier">
        <install-in user-type="FULL" />
        <install-in user-type="android.os.usertype.profile.MANAGED" />
        <install-in user-type="android.os.usertype.profile.PRIVATE" />
    </install-in-user-type>

    <!--  Contacts provider app (ContactsProvider) -->
    <install-in-user-type package="com.android.providers.contacts">
        <install-in user-type="SYSTEM" />
        <install-in user-type="FULL" />
        <install-in user-type="android.os.usertype.profile.MANAGED" />
        <install-in user-type="android.os.usertype.profile.CLONE" />
        <install-in user-type="android.os.usertype.profile.PRIVATE" />
    </install-in-user-type>

    <!--  Pixel Sound Picker app (RELEASE_PACKAGE_PIXEL_SOUND_PICKER) -->
    <install-in-user-type package="com.google.android.soundpicker">
        <install-in user-type="FULL" />
        <install-in user-type="android.os.usertype.profile.MANAGED" />
        <install-in user-type="android.os.usertype.profile.PRIVATE" />
    </install-in-user-type>

    <!--  Gboard app (LatinIMEGooglePrebuilt) -->
    <install-in-user-type package="com.google.android.inputmethod.latin">
        <install-in user-type="FULL" />
        <install-in user-type="android.os.usertype.profile.CLONE" />
        <install-in user-type="android.os.usertype.profile.MANAGED" />
        <install-in user-type="android.os.usertype.profile.PRIVATE" />
        <install-in user-type="android.os.usertype.profile.SUPERVISING" />
    </install-in-user-type>

    <!-- Switch Access Accessibility Service (SwitchAccessPrebuilt) -->
    <install-in-user-type package="com.google.android.accessibility.switchaccess">
        <install-in user-type="FULL" />
    </install-in-user-type>

    <!-- Google Location History (LocationHistoryPrebuilt) -->
    <install-in-user-type package="com.google.android.gms.location.history">
        <install-in user-type="SYSTEM" />
        <install-in user-type="FULL" />
        <install-in user-type="android.os.usertype.profile.MANAGED" />
    </install-in-user-type>

    <!-- Google Restore (RELEASE_PACKAGE_GOOGLE_RESTORE) -->
    <install-in-user-type package="com.google.android.apps.restore">
        <install-in user-type="FULL" />
        <install-in user-type="android.os.usertype.profile.MANAGED" />
    </install-in-user-type>

    <!-- Included SysUI clocks - (SystemUIClocks-BigNum) -->
    <install-in-user-type package="com.android.systemui.clocks.bignum">
        <install-in user-type="FULL" />
    </install-in-user-type>

    <!-- Included SysUI clocks - (SystemUIClocks-Calligraphy) -->
    <install-in-user-type package="com.android.systemui.clocks.calligraphy">
        <install-in user-type="FULL" />
    </install-in-user-type>

    <!-- Included SysUI clocks - (SystemUIClocks-Growth) -->
    <install-in-user-type package="com.android.systemui.clocks.growth">
        <install-in user-type="FULL" />
    </install-in-user-type>

    <!-- Included SysUI clocks - (SystemUIClocks-Inflate) -->
    <install-in-user-type package="com.android.systemui.clocks.inflate">
        <install-in user-type="FULL" />
    </install-in-user-type>

    <!-- Included SysUI clocks - (SystemUIClocks-Metro) -->
    <install-in-user-type package="com.android.systemui.clocks.metro">
        <install-in user-type="FULL" />
    </install-in-user-type>

    <!-- Included SysUI clocks - (SystemUIClocks-NumOverlap) -->
    <install-in-user-type package="com.android.systemui.clocks.numoverlap">
        <install-in user-type="FULL" />
    </install-in-user-type>

    <!-- Included SysUI clocks - (SystemUIClocks-Weather) -->
    <install-in-user-type package="com.android.systemui.clocks.weather">
        <install-in user-type="FULL" />
    </install-in-user-type>

    <!--  Google-branded WebView provider (WebViewGoogle)  -->
    <install-in-user-type package="com.google.android.webview">
        <install-in user-type="SYSTEM" />
        <install-in user-type="FULL" />
        <install-in user-type="PROFILE" />
    </install-in-user-type>

    <!--  Static shared library used by WebView in some configurations (TrichromeLibrary)  -->
    <install-in-user-type package="com.google.android.trichromelibrary">
        <install-in user-type="SYSTEM" />
        <install-in user-type="FULL" />
        <install-in user-type="PROFILE" />
    </install-in-user-type>

    <!--  Search Selector app (SearchSelectorPrebuilt) -->
    <install-in-user-type package="com.google.android.apps.setupwizard.searchselector">
        <install-in user-type="FULL" />
        <install-in user-type="android.os.usertype.profile.MANAGED" />
        <install-in user-type="android.os.usertype.profile.PRIVATE" />
    </install-in-user-type>
</config>
