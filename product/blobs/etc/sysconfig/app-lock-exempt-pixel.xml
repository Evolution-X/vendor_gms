<!--
  This file contains configs for preinstalled packages that are exempt from App Lock on all
  Pixel devices.

  Apps included in this list will not be allowed to have App Lock enabled, and will not present
  any App Lock enablement flows.

  Documentation at frameworks/base/data/etc/app-lock-exempt.xml
-->
<config>
    <app-lock-exempt package="com.android.settings" />
    <app-lock-exempt package="com.google.android.contacts" />
    <app-lock-exempt package="com.google.android.deskclock" />
    <app-lock-exempt package="com.google.android.dialer" />
    <app-lock-exempt package="com.google.android.GoogleCamera" />
</config>
