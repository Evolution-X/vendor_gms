cc_prebuilt_library_shared {
	name: "libpowerstatshaldataprovider",
	owner: "google",
    strip: {
        none: true,
    },
	target: {
		android_arm64: {
			srcs: ["libpowerstatshaldataprovider.so"],
			shared_libs: ["android.hardware.power.stats-V1-ndk",
				  "libbinder_ndk",
				  "libc",
				  "libc++",
				  "libdl",
				  "libhidlbase",
				  "liblog",
				  "libm",
				  "libnativehelper",
				  "libprotobuf-cpp-lite",
				  "libutils",
				  "android.hardware.power.stats@1.0"], 
		},
	},
	ignore_max_page_size: true,
	system_ext_specific: true,
}
